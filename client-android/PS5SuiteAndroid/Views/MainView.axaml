<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="PS5SuiteAndroid.Views.MainView"
             Background="#1E1E1E">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="10,15,15,15">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" x:Name="MenuButton" Content="☰" FontSize="18"
                        Background="Transparent" Foreground="#0E9CFF" Padding="8,0"
                        VerticalAlignment="Center" Click="MenuButton_Click"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#FF6B35" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PS5 Suite" FontSize="20" FontWeight="Bold" Foreground="#0E9CFF"/>
                    </StackPanel>
                    <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" FontSize="11" Foreground="#A0A0A0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation drawer + content -->
        <SplitView Grid.Row="1" x:Name="NavDrawer" DisplayMode="Overlay"
                   CompactPaneLength="0" OpenPaneLength="250"
                   PaneBackground="#252526" IsPaneOpen="False">
            <SplitView.Pane>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#2D2D30" Padding="15,12">
                        <TextBlock Text="Menu" FontSize="14" FontWeight="Bold" Foreground="#0E9CFF"/>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="15,13"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#0E639C"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBoxItem>🔌 Connect</ListBoxItem>
                        <ListBoxItem>📁 File Transfer</ListBoxItem>
                        <ListBoxItem>🎮 Games</ListBoxItem>
                        <ListBoxItem>🛒 Homebrew Store</ListBoxItem>
                        <ListBoxItem>🌐 Prospero Store</ListBoxItem>
                        <ListBoxItem>🏆 Trophies</ListBoxItem>
                        <ListBoxItem>💾 Saves &amp; Media</ListBoxItem>
                        <ListBoxItem>🖥️ System Info</ListBoxItem>
                        <ListBoxItem>🛠️ Tools</ListBoxItem>
                        <ListBoxItem>⚡ Devices</ListBoxItem>
                        <ListBoxItem>📋 Debug Log</ListBoxItem>
                    </ListBox>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
        <Panel x:Name="ContentHost" Background="#1E1E1E">
            <!-- Connect Tab -->
            <Panel x:Name="PageConnect">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="15">
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="PS5 IP Address" Foreground="#A0A0A0" FontSize="14"/>
                                <TextBox x:Name="IpAddressInput" Text="192.168.1.100" Background="#2D2D30" 
                                         BorderBrush="#3E3E42" Padding="12" FontSize="16"/>
                                <Button x:Name="ConnectButton" Content="Connect" Background="#007ACC" 
                                        Foreground="White" Padding="15" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" FontSize="16" Click="ConnectButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Quick Actions" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <Button Content="📁 Browse Files" Background="#3E3E42" Foreground="White" 
                                        Padding="12" HorizontalAlignment="Stretch" Click="BrowseFilesButton_Click"/>
                                <Button Content="🎮 View Games" Background="#3E3E42" Foreground="White" 
                                        Padding="12" HorizontalAlignment="Stretch" Click="ViewGamesButton_Click"/>
                                <Button Content="🖥️ System Info" Background="#3E3E42" Foreground="White" 
                                        Padding="12" HorizontalAlignment="Stretch" Click="SystemInfoButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- Files Tab -->
            <Panel x:Name="PageFiles" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="CurrentPathText" Text="/data" Foreground="#A0A0A0" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="⬆️" Background="#3E3E42" Padding="10" Click="GoUpButton_Click"/>
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="10,6" Orientation="Horizontal">
                        <Button Content="🔄 Refresh" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FilesRefresh_Click"/>
                        <Button Content="📤 Upload" Background="#007ACC" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FileUpload_Click"/>
                        <Button Content="📁 New Folder" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FileNewFolder_Click"/>
                        <Button Content="⬇️ Download" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FileDownload_Click"/>
                        <Button Content="📝 Rename" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FileRename_Click"/>
                        <Button Content="🗑️ Delete" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FileDelete_Click"/>
                    </WrapPanel>
                    <ListBox Grid.Row="2" x:Name="FilesListBox" Background="#1E1E1E" 
                             SelectionMode="Single" DoubleTapped="FilesListBox_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#808080"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#808080" 
                                                   VerticalAlignment="Center" IsVisible="{Binding IsDirectory}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Panel>

            <!-- Games Tab -->
            <Panel x:Name="PageGames" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="GameSearchBox" Watermark="Search games..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="10"
                                         TextChanged="GameSearch_TextChanged"/>
                                <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="10" Click="RefreshGamesButton_Click"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="GameCountText" Text="Games" Foreground="#0E9CFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GameSortCombo" Grid.Column="1" Background="#2D2D30" SelectedIndex="0"
                                          SelectionChanged="GameSort_SelectionChanged">
                                    <ComboBoxItem>Name A→Z</ComboBoxItem>
                                    <ComboBoxItem>Name Z→A</ComboBoxItem>
                                    <ComboBoxItem>Size ↑</ComboBoxItem>
                                    <ComboBoxItem>Size ↓</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="10,6" Orientation="Horizontal">
                        <Button Content="🎮 Mount All" Background="#007ACC" Foreground="White" Padding="10" Margin="0,4,6,4" Click="MountGamesButton_Click"/>
                        <Button Content="📥 Mount" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="MountGameButton_Click"/>
                        <Button Content="▶️ Launch" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="LaunchGameButton_Click"/>
                        <Button Content="⏹ Stop" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="StopGameButton_Click"/>
                        <Button Content="🗑️ Unmount" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="UnmountGameButton_Click"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="2" x:Name="RunningAppsText" Text="" Foreground="#28A745" FontSize="11" Margin="12,0" TextWrapping="Wrap" IsVisible="False"/>
                    <ListBox Grid.Row="3" x:Name="GamesListBox" Background="#1E1E1E">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="8" Padding="12" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="60" Height="60" Background="#3E3E42" 
                                                CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="🎮" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Foreground="#0E9CFF">
                                                <Run Text="{Binding TitleId}"/><Run Text="{Binding RunningBadge}" Foreground="#28A745"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#808080"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Panel>

            <!-- Store Tab -->
            <Panel x:Name="PageStore" IsVisible="False">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="StoreSearchBox" Watermark="Search homebrew..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="10"
                                         TextChanged="StoreSearch_TextChanged"/>
                                <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="10" Click="StoreRefresh_Click"/>
                            </Grid>
                            <TextBlock x:Name="StoreStatusText" Text="Tap 🔄 to fetch pkg-zone catalog" Foreground="#808080" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="StoreListBox" Background="#1E1E1E">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="8" Padding="12" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="52" Height="52" Background="#3E3E42"
                                                CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#0E9CFF"/>
                                            <TextBlock FontSize="10" Foreground="#808080">
                                                <Run Text="{Binding Version}"/><Run Text="  ·  "/><Run Text="{Binding Author}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="📥" Background="#007ACC" Foreground="White"
                                                Padding="8" VerticalAlignment="Center" Tag="{Binding Id}" Click="StoreInstall_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Panel>

            <!-- Prospero Store Tab (homebrew.page native PS5 apps) -->
            <Panel x:Name="PageProspero" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="ProsperoSearchBox" Watermark="Search Prospero store..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="10"
                                         TextChanged="ProsperoSearch_TextChanged"/>
                                <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="10" Click="ProsperoRefresh_Click"/>
                            </Grid>
                            <ComboBox x:Name="ProsperoCategoryCombo" Background="#2D2D30" SelectedIndex="0"
                                      HorizontalAlignment="Stretch" SelectionChanged="ProsperoCategory_SelectionChanged">
                                <ComboBoxItem>📦 All</ComboBoxItem>
                                <ComboBoxItem>🧩 Apps</ComboBoxItem>
                                <ComboBoxItem>🎮 Games</ComboBoxItem>
                                <ComboBoxItem>🔧 Tools</ComboBoxItem>
                                <ComboBoxItem>⏳ Coming soon</ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="ProsperoStatusText" Text="Tap 🔄 to fetch homebrew.page catalog" Foreground="#808080" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <ProgressBar Grid.Row="1" x:Name="ProsperoProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Background="#1E1E1E" Foreground="#0E9CFF" IsVisible="False"/>
                    <ListBox Grid.Row="2" x:Name="ProsperoListBox" Background="#1E1E1E">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="8" Padding="12" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="52" Height="52" Background="#3E3E42"
                                                CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TitleId}" FontSize="11" Foreground="#0E9CFF"/>
                                            <TextBlock FontSize="10" Foreground="#808080">
                                                <Run Text="{Binding MetaLine}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ButtonLabel}" Background="#007ACC" Foreground="White"
                                                Padding="8" VerticalAlignment="Center" Tag="{Binding TitleId}"
                                                IsEnabled="{Binding CanInstall}" Click="ProsperoInstall_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Panel>

            <!-- Trophies Tab -->
            <Panel x:Name="PageTrophies" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TrophySearchBox" Watermark="Search trophy sets..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="10"
                                         TextChanged="TrophySearch_TextChanged"/>
                                <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="10" Click="TrophyRefresh_Click"/>
                            </Grid>
                            <TextBlock x:Name="TrophyStatusText" Text="Tap 🔄 to load trophy sets" Foreground="#808080" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="#252526" Padding="6,0" x:Name="TrophyBackBar" IsVisible="False">
                        <Button Content="← Back to sets" Background="Transparent" Foreground="#0E9CFF"
                                Padding="10" Click="TrophyBack_Click"/>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="TrophySetsListBox" Background="#1E1E1E"
                             SelectionChanged="TrophySet_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="8" Padding="12" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="52" Height="52" Background="#3E3E42"
                                                CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="🏆" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding NpCommunicationId}" FontSize="11" Foreground="#0E9CFF"/>
                                            <TextBlock FontSize="11" Foreground="#808080">
                                                <Run Text="{Binding ProgressDisplay}"/><Run Text=" earned"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox Grid.Row="2" x:Name="TrophyItemsListBox" Background="#1E1E1E" IsVisible="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D30" CornerRadius="8" Padding="10" Margin="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="44" Height="44" Background="#3E3E42"
                                                CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="🏆" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding HiddenDisplay}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding GradeDisplay}" FontSize="10" FontWeight="Bold" Foreground="{Binding GradeBrush}"/>
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="10" Foreground="#808080"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#606060" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                            <Button Content="🔓" Background="#28A745" Foreground="White" Padding="8"
                                                    IsVisible="{Binding CanUnlock}" Click="TrophyUnlock_Click"/>
                                            <Button Content="🔒" Background="#DC3545" Foreground="White" Padding="8"
                                                    IsVisible="{Binding CanLock}" Click="TrophyLock_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Panel>

            <!-- Saves & Media Tab -->
            <Panel x:Name="PageSaves" IsVisible="False">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="15">
                        <!-- Save Images Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="💾 Save Images" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔄 Scan" Background="#3E3E42" Padding="8" Click="SaveScanButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="SaveMountStatusText" Text="No save mounted" Foreground="#808080" FontSize="11"/>
                                <ListBox x:Name="SavesListBox" Background="#1E1E1E" MaxHeight="300">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SaveName}" FontSize="13" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding TitleId}" FontSize="11" Foreground="#0E9CFF"/>
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="#9C27B0"/>
                                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#808080"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🔓 Mount" Background="#007ACC" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveMountButton_Click"/>
                                    <Button Content="🔒 Unmount" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveUnmountButton_Click"/>
                                    <Button Content="📂 Browse" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveBrowseButton_Click"/>
                                    <Button Content="� Backup" Background="#28A745" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveBackupButton_Click"/>
                                    <Button Content="📥 Raw" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveBackupRaw_Click"/>
                                    <Button Content="📤 Restore" Background="#FFC107" Foreground="#1E1E1E" Padding="10" Margin="0,4,6,4" Click="SaveRestoreButton_Click"/>
                                    <Button Content="�🗑️ Delete" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="SaveDeleteButton_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Mounted saves are browsable at /data/save_mnt" Foreground="#606060" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Screenshots Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="📸 Screenshots" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="ScreenshotsRefreshButton_Click"/>
                                </Grid>
                                <ListBox x:Name="ScreenshotsListBox" Background="#1E1E1E" MaxHeight="260">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock FontSize="10" Foreground="#808080">
                                                            <Run Text="{Binding DateDisplay}"/><Run Text="  ·  "/><Run Text="{Binding SizeDisplay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="72" Height="40" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="⬇️ Download" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="ScreenshotDownload_Click"/>
                                    <Button Content="🗑️ Delete Selected" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="ScreenshotDeleteButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- System Tab -->
            <Panel x:Name="PageSystem" IsVisible="False">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="15">
                        <!-- Sensors Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🌡️ Live Sensors" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="RefreshSensorsButton_Click"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="CPU Temp" Foreground="#808080" FontSize="11"/>
                                        <TextBlock x:Name="CpuTempText" Text="—°C" Foreground="#FFA500" FontSize="20" FontWeight="Bold"/>
                                        <ProgressBar x:Name="CpuTempBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E1E1E" Foreground="#FF6B35"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="SoC Temp" Foreground="#808080" FontSize="11"/>
                                        <TextBlock x:Name="SocTempText" Text="—°C" Foreground="#FFA500" FontSize="20" FontWeight="Bold"/>
                                        <ProgressBar x:Name="SocTempBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E1E1E" Foreground="#FF6B35"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                        <TextBlock Text="CPU Freq" Foreground="#808080" FontSize="11"/>
                                        <TextBlock x:Name="CpuFreqText" Text="— MHz" Foreground="#0E9CFF" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                                        <TextBlock Text="Power" Foreground="#808080" FontSize="11"/>
                                        <TextBlock x:Name="PowerText" Text="— W" Foreground="#28A745" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CPU Usage Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="📊 CPU Usage" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 0:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu0Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu0Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 4:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu4Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu4Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 1:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu1Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu1Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 5:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu5Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu5Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 2:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu2Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu2Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 6:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu6Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu6Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 3:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu3Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu3Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Core 7:" Foreground="#808080" Width="50" FontSize="12"/>
                                        <TextBlock x:Name="Cpu7Text" Text="—%" Foreground="#9CDCFE" Width="40" FontSize="12"/>
                                        <ProgressBar x:Name="Cpu7Bar" Height="10" Width="60" Minimum="0" Maximum="100" Background="#1E1E1E" Foreground="#007ACC"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Average:" Foreground="#808080" FontSize="12"/>
                                        <TextBlock x:Name="CpuAvgText" Text="—%" Foreground="#28A745" FontWeight="Bold" FontSize="14" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Memory Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="💾 Memory" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Direct Total:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MemTotalText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Available:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MemAvailText" Text="—" Foreground="#28A745" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Used:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemUsedText" Text="—" Foreground="#FFC107" FontSize="12" Margin="10,2,0,2"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <ProgressBar x:Name="MemUsageBar" Height="20" Minimum="0" Maximum="100" Value="0" Background="#1E1E1E" Foreground="#007ACC"/>
                                    <TextBlock x:Name="MemUsageText" Text="—%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Info Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="📋 System Info" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModelText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Firmware:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FirmwareText" Text="—" Foreground="#28A745" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Uptime:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UptimeText" Text="—" Foreground="#FFC107" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Boot Count:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BootCountText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="BD Drive:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BdDriveText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Extended Info Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🔧 Extended Info" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="ExtInfoRefresh_Click"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Prospero:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProsperoText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Product:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProductText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Shutdowns:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ShutdownCountText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Thermal Alert:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ThermalAlertText" Text="—" Foreground="#FFA500" FontSize="12" Margin="10,2,0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="BD Power:" Foreground="#808080" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BdPowerText" Text="—" FontSize="12" Margin="10,2,0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Network Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🌐 Network" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="NetRefresh_Click"/>
                                </Grid>
                                <TextBlock x:Name="NetInfoText" Text="Not loaded" Foreground="#A0A0A0" FontSize="12" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Content="⚡ Speed Test" Background="#007ACC" Foreground="White"
                                            Padding="10" HorizontalAlignment="Stretch" Click="NetSpeed_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="NetSpeedText" Text="" Foreground="#28A745" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Modules Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="📦 Loaded Modules" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="ModulesRefresh_Click"/>
                                </Grid>
                                <ListBox x:Name="ModulesListBox" Background="#1E1E1E" MaxHeight="260">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="4" Padding="8" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#9CDCFE" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Info}" Foreground="#808080" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- Tools Tab -->
            <Panel x:Name="PageTools" IsVisible="False">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="15">
                        <!-- PKG Install Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📦 Install PKG" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="PKG path on PS5 or HTTP URL:" Foreground="#A0A0A0" FontSize="12"/>
                                <TextBox x:Name="PkgPathInput" Watermark="/user/data/pkg/game.pkg or http://..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="12" FontSize="13"/>
                                <Button Content="📦 Install PKG" Background="#007ACC" Foreground="White"
                                        Padding="12" HorizontalAlignment="Stretch" Click="InstallPkgButton_Click"/>
                                <ProgressBar x:Name="PkgProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Background="#1E1E1E" Foreground="#0E9CFF"/>
                                <TextBlock x:Name="PkgStatusText" Text="Idle" Foreground="#808080" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Fan Control Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🌀 Fan Control" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Current threshold:" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FanCurrentText" Text="—" Foreground="#FFA500" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="🔄" Background="#3E3E42" Padding="8" Click="FanRefreshButton_Click"/>
                                </StackPanel>
                                <Slider x:Name="FanSlider" Minimum="30" Maximum="90" Value="60"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="FanSlider_ValueChanged"/>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Cool 50°" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FanPreset_Click"/>
                                    <TextBlock x:Name="FanSliderText" Text="60°C" FontSize="18" FontWeight="Bold"
                                               Foreground="#0E9CFF" VerticalAlignment="Center" MinWidth="60" Margin="0,4"/>
                                    <Button Content="Quiet 70°" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="FanPreset_Click"/>
                                </WrapPanel>
                                <Button Content="🌀 Set Threshold" Background="#007ACC" Foreground="White"
                                        Padding="12" HorizontalAlignment="Stretch" Click="FanSetButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Shell Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="💻 Shell" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="ShellOutputBox" IsReadOnly="True" Height="180" FontFamily="Consolas" FontSize="11"
                                         Background="#0D0D0D" BorderBrush="#3E3E42" Padding="8" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="ShellInputBox" Watermark="command..."
                                             Background="#2D2D30" BorderBrush="#3E3E42" Padding="10" FontSize="12"
                                             KeyDown="ShellInput_KeyDown"/>
                                    <Button Grid.Column="1" Content="▶" Background="#007ACC" Foreground="White" Padding="12" Click="ShellExec_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Search Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔍 File Search" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="📇 Index" Background="#3E3E42" Padding="8" Click="IndexStart_Click"/>
                                    <TextBlock x:Name="IndexStatusText" Text="index not built" Foreground="#808080" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="SearchBox" Watermark="search pattern..."
                                             Background="#2D2D30" BorderBrush="#3E3E42" Padding="10" FontSize="12"/>
                                    <Button Grid.Column="1" Content="🔍" Background="#007ACC" Foreground="White" Padding="10" Click="SearchRun_Click"/>
                                </Grid>
                                <ListBox x:Name="SearchResultsBox" Background="#1E1E1E" MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#9CDCFE" FontSize="11" Margin="4,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Memory Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🧠 Memory" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBox x:Name="MemPidBox" Watermark="pid" Width="100" Margin="0,4,6,4"
                                             Background="#2D2D30" BorderBrush="#3E3E42" Padding="10" FontSize="12"/>
                                    <Button Content="📋 Regions" Background="#3E3E42" Foreground="White" Padding="8" Margin="0,4,6,4" Click="MemRegions_Click"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBox x:Name="MemAddrBox" Watermark="0xaddr" Width="150" Margin="0,4,6,4"
                                             Background="#2D2D30" BorderBrush="#3E3E42" Padding="10" FontSize="12"/>
                                    <TextBox x:Name="MemLenBox" Watermark="len" Width="80" Margin="0,4,6,4"
                                             Background="#2D2D30" BorderBrush="#3E3E42" Padding="10" FontSize="12"/>
                                    <Button Content="📖 Read" Background="#007ACC" Foreground="White" Padding="8" Margin="0,4,6,4" Click="MemRead_Click"/>
                                </WrapPanel>
                                <TextBox x:Name="MemOutputBox" IsReadOnly="True" Height="160" FontFamily="Consolas" FontSize="10"
                                         Background="#0D0D0D" BorderBrush="#3E3E42" Padding="8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Apps Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🎯 Running Apps" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="AppsRefresh_Click"/>
                                </Grid>
                                <ListBox x:Name="AppsListBox" Background="#1E1E1E" MaxHeight="260"
                                         SelectionChanged="AppsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding TitleId}" FontSize="10" Foreground="#0E9CFF"/>
                                                        <TextBlock Text="{Binding Cpu}" FontSize="10" Foreground="#9CDCFE"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FFA500"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⏸ Suspend" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="AppSuspend_Click"/>
                                    <Button Content="▶ Resume" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="AppResume_Click"/>
                                    <Button Content="⏹ Kill" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="AppKill_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Kernel Log Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🧾 Kernel Log" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="KlogRefresh_Click"/>
                                </Grid>
                                <TextBox x:Name="KlogBox" IsReadOnly="True" Height="220" FontFamily="Consolas" FontSize="10"
                                         Background="#0D0D0D" BorderBrush="#3E3E42" Padding="8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- Devices Tab -->
            <Panel x:Name="PageDevices" IsVisible="False">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="15">
                        <!-- Power Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="⚡ Power" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🔄 Reboot" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="PowerReboot_Click"/>
                                    <Button Content="⏻ Shutdown" Background="#DC3545" Foreground="White" Padding="10" Margin="0,4,6,4" Click="PowerShutdown_Click"/>
                                    <Button Content="📺 Restart Shell UI" Background="#3E3E42" Foreground="White" Padding="10" Margin="0,4,6,4" Click="RestartUi_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- USB Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🔌 USB Drives" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔄" Background="#3E3E42" Padding="8" Click="UsbRefresh_Click"/>
                                </Grid>
                                <TextBlock x:Name="UsbListText" Text="No USB drives scanned" Foreground="#A0A0A0" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Controller Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🎮 Controller" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔄 Info" Background="#3E3E42" Padding="8" Click="PadRefresh_Click"/>
                                </Grid>
                                <TextBlock x:Name="PadInfoText" Text="—" Foreground="#A0A0A0" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="Light Bar" Foreground="#A0A0A0" FontSize="12"/>
                                <WrapPanel>
                                    <Button Content="🔵" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="0,0,255"/>
                                    <Button Content="🔴" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="255,0,0"/>
                                    <Button Content="🟢" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="0,255,0"/>
                                    <Button Content="🟣" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="128,0,255"/>
                                    <Button Content="⚪" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="255,255,255"/>
                                    <Button Content="⚫" Padding="8" Margin="2" Background="#3E3E42" Click="LightBar_Click" Tag="0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Console LED Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="💡 Console LED" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Bright" Background="#3E3E42" Foreground="White" Padding="8" Margin="0,4,6,4" Click="LedDim_Click" Tag="0"/>
                                    <Button Content="Medium" Background="#3E3E42" Foreground="White" Padding="8" Margin="0,4,6,4" Click="LedDim_Click" Tag="1"/>
                                    <Button Content="Dim" Background="#3E3E42" Foreground="White" Padding="8" Margin="0,4,6,4" Click="LedDim_Click" Tag="2"/>
                                </WrapPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox x:Name="LedEffectCombo" Grid.Column="0" Background="#2D2D30" SelectedIndex="1">
                                        <ComboBoxItem>off</ComboBoxItem>
                                        <ComboBoxItem>white</ComboBoxItem>
                                        <ComboBoxItem>white-dim</ComboBoxItem>
                                        <ComboBoxItem>blue</ComboBoxItem>
                                        <ComboBoxItem>orange</ComboBoxItem>
                                        <ComboBoxItem>purple</ComboBoxItem>
                                        <ComboBoxItem>pink</ComboBoxItem>
                                        <ComboBoxItem>sunrise</ComboBoxItem>
                                        <ComboBoxItem>blue-breathe</ComboBoxItem>
                                        <ComboBoxItem>white-breathe</ComboBoxItem>
                                        <ComboBoxItem>orange-breathe</ComboBoxItem>
                                        <ComboBoxItem>pink-breathe</ComboBoxItem>
                                        <ComboBoxItem>pink-breathe-fast</ComboBoxItem>
                                        <ComboBoxItem>blue-to-richblue</ComboBoxItem>
                                        <ComboBoxItem>blue-white-anim</ComboBoxItem>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="✨ Apply" Background="#007ACC" Foreground="White" Padding="10" Click="LedEffect_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Beeper Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔊 Beeper" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <WrapPanel>
                                    <Button Content="1×" Padding="10" Margin="2" Background="#3E3E42" Click="Beep_Click" Tag="1"/>
                                    <Button Content="2×" Padding="10" Margin="2" Background="#3E3E42" Click="Beep_Click" Tag="2"/>
                                    <Button Content="3×" Padding="10" Margin="2" Background="#3E3E42" Click="Beep_Click" Tag="3"/>
                                    <Button Content="Mute" Padding="10" Margin="2" Background="#DC3545" Click="BeepMute_Click" Tag="1"/>
                                    <Button Content="Unmute" Padding="10" Margin="2" Background="#3E3E42" Click="BeepMute_Click" Tag="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Notification Card -->
                        <Border Background="#252526" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔔 Notification" Foreground="#0E9CFF" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="NotifyTextBox" Watermark="Message to show on PS5..."
                                         Background="#2D2D30" BorderBrush="#3E3E42" Padding="12" FontSize="13"/>
                                <Button Content="🔔 Send" Background="#007ACC" Foreground="White"
                                        Padding="10" HorizontalAlignment="Stretch" Click="NotifySend_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- Debug Log Tab -->
            <Panel x:Name="PageLog" IsVisible="False">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#252526" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <CheckBox x:Name="LogAutoScroll" Content="Auto-scroll" Foreground="#A0A0A0" IsChecked="True"/>
                            <Button Content="🗑️ Clear" Background="#3E3E42" Padding="8" Click="LogClear_Click"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="LogScroller" Background="#1E1E1E">
                        <ItemsControl x:Name="LogItems" Margin="8"/>
                    </ScrollViewer>
                </Grid>
            </Panel>
        </Panel>
            </SplitView.Content>
        </SplitView>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#252526" Padding="10">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#808080" FontSize="11" HorizontalAlignment="Center"/>
        </Border>

        <!-- Modal dialog overlay (message / confirm / input) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DialogOverlay" IsVisible="False"
              Background="#AA000000">
            <Border Background="#252526" CornerRadius="12" Padding="20" Margin="24"
                    MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#3E3E42" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="DialogTitle" Text="Title" FontSize="16" FontWeight="Bold" Foreground="#0E9CFF"/>
                    <ScrollViewer MaxHeight="300">
                        <TextBlock x:Name="DialogMessage" Text="" FontSize="13" Foreground="#E0E0E0" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <TextBox x:Name="DialogInput" Watermark="" Background="#2D2D30" BorderBrush="#3E3E42"
                             Padding="10" FontSize="14" IsVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="DialogCancelButton" Content="Cancel" Background="#3E3E42" Foreground="White"
                                Padding="16,10" Click="DialogCancel_Click"/>
                        <Button x:Name="DialogOkButton" Content="OK" Background="#007ACC" Foreground="White"
                                Padding="16,10" Click="DialogOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
